{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "required": true,
      "inversedBy": "quizzes"
    },
    "passingScore": {
      "type": "integer",
      "required": true
    },
    "timeLimit": {
      "type": "integer",
      "required": true
    },
    "questions": {
      "type": "component",
      "component": "quiz.question",
      "repeatable": true,
      "required": true
    },
    "maxAttempts": {
      "type": "integer",
      "required": true,
      "default": 3
    },
    "quiz_attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-attempt.quiz-attempt",
      "mappedBy": "quiz"
    }
  }
}
